# Database (PostgreSQL + PostGIS)
POSTGRES_USER=staturemap
POSTGRES_PASSWORD=staturemap_secret
POSTGRES_DB=pg_staturemap_dev
DATABASE_URL="postgresql://staturemap:staturemap_secret@localhost:5432/pg_staturemap_dev"

# Redis (BullMQ)
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="ganti-dengan-string-acak-minimum-32-karakter"
JWT_EXPIRES_IN="7d"   # optional — default 7d; jose duration string (e.g. "1d", "8h")

# App
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
